# Copy this file to backend/.env and fill in real values. Never commit .env.
# This file must live in backend/ (same folder as requirements.txt) because
# the app loads it relative to the working directory you run uvicorn from.

# --- Database ---
# Points at a PostgreSQL server running locally on your machine.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_pdf_assistant

# --- Auth ---
# Generate a strong random value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- AI / RAG ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=replace-with-your-gemini-api-key

# --- Chunking ---
CHUNK_SIZE_WORDS=600
CHUNK_OVERLAP_WORDS=100

# --- Retrieval ---
TOP_K=5
SIMILARITY_THRESHOLD=0.25

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=20
# Relative to backend/ (where you run uvicorn from). Created automatically.
UPLOAD_DIR=./uploaded_files

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
